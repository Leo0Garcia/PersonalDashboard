# Public build-time config. Both values are designed to be public: the
# publishable key grants nothing on its own because every table is protected
# by row-level security. Committed so a Vercel build needs no dashboard setup.
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is the public half of the Web Push keypair. It
# is meant to be public — it ships in the browser bundle and is what the push
# service checks signatures against. The PRIVATE half lives only in Supabase
# Edge Function secrets and must never appear here.
NEXT_PUBLIC_SUPABASE_URL=https://elbocxmdfdjhtbrprmen.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Gs_b0lXEQ1wwONitk54PYw_-l4ljkQ8
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLsePxJchR11DaHA1u_QNm-CcUvGT_SGPHkFi29oXVmBJBCSgVU43LuWVvQwy_uPsoiEGkjtiIlR37zQIGoaw7s
