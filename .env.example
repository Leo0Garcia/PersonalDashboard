# Client-safe. The publishable key is designed to be public and is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid public key, base64url>

# Server-only. NEVER prefix these with NEXT_PUBLIC_.
# VAPID_PRIVATE_KEY lives as a Supabase Edge Function secret, not here.
